# Copy to .env and fill in. .env is gitignored.

# --- Ring ---
RING_EMAIL=
RING_PASSWORD=

# --- Home Assistant ---
# Base URL of your HA instance (no trailing slash needed).
HA_URL=http://homeassistant.local:8123
# Long-lived access token: HA -> your profile -> Security -> Long-lived access tokens.
HA_TOKEN=
# The notify service target, i.e. notify.<this>. For the companion app it is
# usually notify.mobile_app_<your_device>; here you give just the suffix.
HA_NOTIFY_TARGET=mobile_app_pixel

# --- Optional tuning ---
# Minimum YOLO confidence (0-1) for a label to count.
MIN_CONFIDENCE=0.35
# Comma-separated Ring event kinds to act on.
EVENT_KINDS=motion,ding
# Send a low-key alert even when nothing is recognised (true/false).
NOTIFY_ON_EMPTY=true
# Override where the auth/FCM token cache is stored.
# TOKEN_CACHE_PATH=~/.config/ring-smart-alerts/token.json
# Override the temp dir used for in-flight snapshots.
# SNAPSHOT_DIR=/tmp/ring-smart-alerts
